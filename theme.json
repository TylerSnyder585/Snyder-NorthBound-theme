{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "palette": [
        { "slug": "base", "color": "#ffede0", "name": "Cream" },
        { "slug": "contrast", "color": "#252526", "name": "Charcoal" },
        { "slug": "accent-1", "color": "#5C413A", "name": "Espresso" },
        { "slug": "accent-2", "color": "#c25b3e", "name": "Terracotta" },
        { "slug": "accent-3", "color": "#dfa081", "name": "Peachy" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "slug": "heading", "name": "Heading", "fontFamily": "'Bebas Neue', serif" },
        { "slug": "body", "name": "Body", "fontFamily": "'Varela Round', sans-serif" },
        { "slug": "display", "name": "Display", "fontFamily": "'Bagel Fat One', serif" }
      ],
      "fontSizes": [
        {
          "fluid": false,
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "fluid": {
            "max": "1.125rem",
            "min": "1rem"
          },
          "name": "Medium",
          "size": "1rem",
          "slug": "medium"
        },
        {
          "fluid": {
            "max": "1.375rem",
            "min": "1.125rem"
          },
          "name": "Large",
          "size": "1.38rem",
          "slug": "large"
        },
        {
          "fluid": {
            "max": "2rem",
            "min": "1.75rem"
          },
          "name": "Extra Large",
          "size": "1.75rem",
          "slug": "x-large"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|base",
      "text": "var:preset|color|contrast"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|heading"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|accent-3"
        }
      }
    },
    "blocks": {
      "core/button": {
        "color": {
          "background": "var:preset|color|contrast",
          "text": "var:preset|color|accent-2"
        },
        "border": {
          "radius": "4px"
        },
        "core/navigation": {
          "typography": {
          "fontFamily": "var:preset|font-family|heading"
        },
          "color": {
          "background": "var:preset|color|contrast",
          "text": "var:preset|color|base"
        }
        }
      }
    }
  }
}